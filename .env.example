# Copy this file to Backend/.env and fill in the values.
# Every value is optional: the API still starts without them, and
# /api/send-alert is disabled unless you opt in below.

# Alert dispatch is OFF by default. To enable it, set ALERTS_ENABLED=true AND
# a long random ALERT_API_KEY. Callers must then send that key in the
# x-alert-key request header. The key is server-side only; never put it in
# Frontend/ or any public JavaScript.
ALERTS_ENABLED=false
ALERT_API_KEY=

# Twilio (SMS). TWILIO_PHONE_NUMBER must be an E.164 number, e.g. +1385...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Gmail SMTP. SMTP_PASSWORD must be a Google App Password, not the account password.
SMTP_EMAIL=
SMTP_PASSWORD=

# Extra browser origins allowed by CORS, comma separated.
# Same-origin requests (the app's own pages) always work.
# Example: https://safesip.vercel.app,http://localhost:5500
ALLOWED_ORIGINS=
